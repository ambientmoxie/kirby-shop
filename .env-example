# ============================================
# VITE DEV SERVER
# Set to "true" in local development only
# Never set this on the live server
# ============================================

VITE_DEV=true

# ============================================
# STRIPE CREDENTIALS
# https://dashboard.stripe.com/apikeys
# ============================================

STRIPE_LIVE_PUBLIC_KEY=pk_live_your_key
STRIPE_LIVE_SECRET_KEY=sk_live_your_key
STRIPE_TEST_PUBLIC_KEY=pk_test_your_key
STRIPE_TEST_SECRET_KEY=sk_test_your_key

# ============================================
# EMAIL CONFIGURATION
# SMTP credentials for transactional emails
# ============================================

EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USERNAME=your_smtp_username@example.com
EMAIL_PASSWORD=your_smtp_password
